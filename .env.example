# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration key. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional explicit production webhook endpoint; otherwise NEXT_PUBLIC_APP_URL is used.
TELEGRAM_WEBHOOK_URL=

# Phase 2: Google Sheets service account and target spreadsheet
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Production site address, for example https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TELEGRAM_BOT_URL=
